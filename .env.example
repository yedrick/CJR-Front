# Copia este archivo como .env.testing o .env.production y ajusta los valores.
# Todas las variables VITE_* se incrustan en el frontend: NUNCA pongas secretos reales aquí.

VITE_APP_ENV=testing                       # testing | production
VITE_APP_NAME="CJN Campamentos"

VITE_USE_MOCK_API=true                     # true = API simulada en el navegador; false = API real
VITE_API_URL=http://localhost:8080/api/v1  # URL base de la API real
VITE_API_TIMEOUT_MS=15000

VITE_MOCK_LATENCY_MS=350                   # latencia simulada (ms)
VITE_MOCK_ERROR_RATE=0                     # % de errores 500 aleatorios (0-100)
VITE_MOCK_JWT_SECRET=cambia-esta-clave     # solo para el servidor simulado
VITE_MOCK_ACCESS_TOKEN_TTL_MIN=15

VITE_SHOW_DEMO_ACCOUNTS=true               # muestra cuentas de prueba en el login

VITE_ENABLE_PWA=true                       # registra el service worker (app instalable)
VITE_NOTIFICATIONS_POLL_MS=20000           # cada cuánto se consultan notificaciones
VITE_VAPID_PUBLIC_KEY=                     # clave pública VAPID para Web Push (opcional)
