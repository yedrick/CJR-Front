# ─────────────────────────────────────────────────────────────
# ENTORNO DE PRUEBAS (testing)
#   npm run dev            → levanta este entorno
#   npm run build:testing  → compila este entorno
# Usa la API simulada (mock) dentro del navegador: no necesita backend.
# ─────────────────────────────────────────────────────────────
VITE_APP_ENV=testing
VITE_APP_NAME="CJN Campamentos (Pruebas)"

# API: si VITE_USE_MOCK_API=true se usa el servidor simulado y VITE_API_URL se ignora.
VITE_USE_MOCK_API=true
VITE_API_URL=http://localhost:8080/api/v1
VITE_API_TIMEOUT_MS=15000

# Simulación (solo mock): latencia en ms y % de errores 500 aleatorios (0 = desactivado)
VITE_MOCK_LATENCY_MS=350
VITE_MOCK_ERROR_RATE=0
# Clave para firmar los JWT del servidor simulado (en un backend real vive SOLO en el servidor)
VITE_MOCK_JWT_SECRET=cjn-testing-secret-no-usar-en-produccion
VITE_MOCK_ACCESS_TOKEN_TTL_MIN=15

# Muestra las cuentas de prueba en el inicio de sesión
VITE_SHOW_DEMO_ACCOUNTS=true

# PWA y notificaciones
VITE_ENABLE_PWA=true
VITE_NOTIFICATIONS_POLL_MS=20000
# Clave pública VAPID para Web Push (vacía = solo notificaciones locales)
VITE_VAPID_PUBLIC_KEY=
