# ─────────────────────────────────────────────────────────────
# ENTORNO DE PRODUCCIÓN
#   npm run build      → compila este entorno
#   npm run dev:prod   → lo levanta en local
# Consume la API real del backend.
# ─────────────────────────────────────────────────────────────
VITE_APP_ENV=production
VITE_APP_NAME="CJN Campamentos"

# API real (cambiar por la URL del backend). Poner VITE_USE_MOCK_API=true solo para demos sin backend.
VITE_USE_MOCK_API=false
VITE_API_URL=https://api.cjn.bo/api/v1
VITE_API_TIMEOUT_MS=15000

# Solo se usan si VITE_USE_MOCK_API=true
VITE_MOCK_LATENCY_MS=0
VITE_MOCK_ERROR_RATE=0
VITE_MOCK_JWT_SECRET=
VITE_MOCK_ACCESS_TOKEN_TTL_MIN=15

VITE_SHOW_DEMO_ACCOUNTS=false

VITE_ENABLE_PWA=true
VITE_NOTIFICATIONS_POLL_MS=60000
VITE_VAPID_PUBLIC_KEY=
